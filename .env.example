# Never use example strings as credentials. scripts/configure.py creates random values.
POSTGRES_PASSWORD=replace-with-random-value
APP_DATABASE_PASSWORD=replace-with-another-random-value
# API reads hashes and explicit permissions from ignored .secrets/keys.json.
RATE_PER_MINUTE=60
RATE_BURST=60
# Optional external model routing; sends query/title/excerpts to the configured provider.
SELECTOR_URL=
SELECTOR_PROVIDER=openai-compatible
SELECTOR_MODEL=
SELECTOR_API_KEY=
SELECTOR_MAX_CALLS=1000
SELECTOR_MAX_OUTPUT_TOKENS=1024
# Shared deployment budgets for API and parser; restart both after changes.
PARSER_MAX_BYTES=25000000
PARSER_MAX_TEXT=20000000
PARSER_MAX_NODES=50000
PARSER_MAX_PDF_PAGES=2000
PARSER_WALL_SECONDS=300
PARSER_CPU_SECONDS=300
PARSER_MEMORY_MB=1024
PARSER_OCR_PAGE_SECONDS=30
PARSER_OCR_MAX_PIXELS=12000000
OCR_MODE=auto
OCR_LANGUAGES=eng+ita
