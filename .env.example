# Never use example strings as credentials. scripts/configure.py creates random values.
POSTGRES_PASSWORD=replace-with-random-value
APP_DATABASE_PASSWORD=replace-with-another-random-value
# API reads hashes and explicit permissions from ignored .secrets/keys.json.
RATE_PER_MINUTE=60
RATE_BURST=60
# Optional external model routing; sends query/title/excerpts to the configured provider.
SELECTOR_URL=
SELECTOR_MODEL=
SELECTOR_API_KEY=
