FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends postgresql ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md LICENSE constraints.txt requirements.training.txt ./
COPY src ./src
RUN pip install --no-cache-dir --upgrade 'pip>=26.3,<27' \
    && pip install --no-cache-dir -c constraints.txt '.[dev,eval]' \
    && pip install --no-cache-dir -r requirements.training.txt \
    && pip check
COPY scripts ./scripts
COPY configs ./configs
COPY datasets ./datasets
CMD ["python", "scripts/train_qwen3.py", "--help"]
